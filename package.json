{
  "name": "famerace",
  "private": true,
  "version": "0.1.0",
  "description": "FameRace \u2014 the internet's talent draft. Back the rise.",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "npm run dev -w apps/web",
    "build": "npm run db:generate && npm run build -w apps/web",
    "start": "npm run start -w apps/web",
    "typecheck": "tsc -p packages/core && tsc -p apps/web --noEmit",
    "test": "npm run db:deploy:test && vitest run",
    "db:deploy:test": "DATABASE_URL=${TEST_DATABASE_URL:-postgresql://famerace:famerace@localhost:5432/famerace_test} sh scripts/prisma.sh migrate deploy --schema packages/db/prisma/schema.prisma",
    "copylint": "node scripts/copylint.mjs",
    "check": "npm run typecheck && npm run copylint && npm run test",
    "db:generate": "sh scripts/prisma.sh generate --schema packages/db/prisma/schema.prisma",
    "db:migrate": "sh scripts/prisma.sh migrate dev --schema packages/db/prisma/schema.prisma",
    "db:deploy": "sh scripts/prisma.sh migrate deploy --schema packages/db/prisma/schema.prisma",
    "db:seed": "tsx packages/db/src/seed.ts",
    "postinstall": "sh scripts/fetch-prisma-engines.sh || true"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "prisma": "^6.5.0",
    "tsx": "^4.19.0",
    "typescript": "^5.7.0",
    "vitest": "^3.0.0"
  },
  "engines": {
    "node": ">=20"
  }
}