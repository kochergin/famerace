# PostgreSQL connection (see docs/IMPLEMENTATION_PLAN.md §1)
DATABASE_URL="postgresql://famerace:famerace@localhost:5432/famerace"

# 32+ byte secret used to sign session tokens
SESSION_SECRET="change-me-to-a-long-random-string"

# Season configuration overrides (optional; defaults in packages/core/src/config.ts)
# LAUNCH_REQUIRED_BACKERS=250
# LAUNCH_REQUIRED_DEMAND_CENTS=1000000

# Payments: usdc = wallet-balance rail (native), anything else = instant dev provider
PAYMENT_PROVIDER=usdc
# Dev-only faucet button on /wallet (never enable in production)
DEV_FAUCET=1
